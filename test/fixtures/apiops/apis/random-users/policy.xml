<policies>
    <inbound>
        <base />
        <!-- arguments -->
        <set-variable name="ru-arg-results" value="@(context.Request.Url.Query.GetValueOrDefault("count", "25"))" />
        <set-variable name="ru-arg-seed" value="@(context.Request.Url.Query.GetValueOrDefault("seed", "thmsn"))" />
        <set-variable name="ru-arg-page" value="@(context.Request.Url.Query.GetValueOrDefault("page", "1"))" />
        <set-variable name="ru-arg-gender" value="@(context.Request.Url.Query.GetValueOrDefault("gender", ""))" />
        <set-variable name="ru-arg-nationalities" value="gb,ie,nz,au" />
        <set-variable name="ru-arg-include-fields" value="name,email,dob,nat,gender,location,login,picture" />
        <set-variable name="ru-arg-min-age" value="@(context.Request.Url.Query.GetValueOrDefault("minAge", "18"))" />
        <set-variable name="ru-arg-max-age" value="@(context.Request.Url.Query.GetValueOrDefault("maxAge", "65"))" />
        <set-variable name="ru-arg-sort-by" value="@(context.Request.Url.Query.GetValueOrDefault("sort", "age"))" />
        <set-variable name="ru-arg-sort-direction" value="desc" />
        <set-variable name="ru-arg-take" value="10" />
        <set-variable name="ru-arg-timeout-seconds" value="@(5)" />
        <set-variable name="ru-arg-cache-seconds" value="{{random-user-cache-seconds}}" />
        <set-variable name="ru-arg-fail-mode" value="throw" />

        <include-fragment fragment-id="random-user-pipeline" />

        <!-- return values -->
        <return-response>
            <set-status code="200" reason="OK" />
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-header name="X-Cache" exists-action="override">
                <value>@((bool)context.Variables["ru-ret-cache-hit"] ? "HIT" : "MISS")</value>
            </set-header>
            <set-header name="Server-Timing" exists-action="override">
                <value>@($"random-user;dur={context.Variables["ru-ret-elapsed-ms"]}")</value>
            </set-header>
            <set-body>@{
                var status = (string)context.Variables["ru-ret-status"];
                return new JObject {
                    ["status"] = status,
                    ["summary"] = new JObject {
                        ["count"] = (int)context.Variables["ru-ret-count"],
                        ["averageAge"] = (double)context.Variables["ru-ret-average-age"],
                        ["oldest"] = (string)context.Variables["ru-ret-oldest-email"],
                        ["genderRatio"] = (string)context.Variables["ru-ret-gender-ratio"],
                        ["byNationality"] = (JObject)context.Variables["ru-ret-nationality-histogram"],
                    },
                    ["users"] = (JArray)context.Variables["ru-ret-users"],
                    ["errors"] = (JArray)context.Variables["ru-ret-errors"],
                }.ToString();
            }</set-body>
        </return-response>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
