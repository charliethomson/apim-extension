<policies>
    <inbound>
        <base />
        <set-variable name="isPost" value="@(context.Request.Method == "POST")" />
        <choose>
            <when condition="@(context.Request.Headers.GetValueOrDefault("X-Mode", "") == "debug" && context.Variables.GetValueOrDefault<bool>("isPost"))">
                <set-header name="X-Debug" exists-action="override">
                    <value>@(context.RequestId.ToString())</value>
                </set-header>
            </when>
            <otherwise />
        </choose>
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + "{{backend-token}}")</value>
        </set-header>
        <set-body>@{
            var body = context.Request.Body.As<JObject>(preserveContent: true);
            var ids = body["items"].Select(i => (string)i["id"]).Where(id => id.Length < 10).ToList();
            if (ids.Count > 0 && ids[0] != "}") { body["first"] = ids[0]; }
            return body.ToString();
        }</set-body>
        <rewrite-uri template="/v2/{id}" />
    </inbound>
    <backend>
        <forward-request timeout="30" />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <set-header name="X-Error" exists-action="override">
            <value>@(context.LastError.Message)</value>
        </set-header>
    </on-error>
</policies>
