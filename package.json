{
  "name": "apim-extension",
  "private": true,
  "description": "Workspace root for the Azure APIM Policies extension: the packages it is built from, the extension itself and the bench.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "extension",
    "cli",
    "bench"
  ],
  "scripts": {
    "build": "npm run build -w extension",
    "watch": "npm run watch -w extension",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:integration": "npm run test:integration -w extension",
    "package": "npm run package -w extension",
    "bench": "npm run bench -w bench",
    "package:cli": "npm run package -w @charliethomson/apim-cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "diff": "^8.0.3"
  }
}
