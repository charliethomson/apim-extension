{
  "name": "apim-policy",
  "displayName": "Azure APIM Policies",
  "description": "Editor support for Azure API Management policy files: tolerant parsing, structural diagnostics and C# IntelliSense inside policy expressions.",
  "version": "0.0.1",
  "publisher": "thmsn-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charliethomson/apim-extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "azure",
    "apim",
    "api management",
    "policy",
    "policies"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:apim-policy"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, the C# extension isn't used, because it would generate a .NET project and restore it from NuGet. Expressions get the built-in C# engine instead, and everything else works as usual."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The C# extension's features inside expressions need the .NET SDK and a local file system. The built-in C# engine works everywhere."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "apim-policy",
        "aliases": [
          "APIM Policy",
          "apim-policy"
        ],
        "filenamePatterns": [
          "*.policy.xml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "apim-policy",
        "scopeName": "text.xml.apim",
        "path": "./syntaxes/apim-policy.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.cs": "csharp",
          "meta.embedded.block.cs": "csharp"
        },
        "tokenTypes": {
          "meta.embedded.expression.cs": "other",
          "meta.embedded.block.cs": "other",
          "meta.embedded.expression.cs string": "string",
          "meta.embedded.block.cs string": "string",
          "meta.embedded.expression.cs comment": "comment",
          "meta.embedded.block.cs comment": "comment"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational.cs",
          "keyword.operator.arrow.cs",
          "punctuation.accessor.pointer.cs",
          "keyword.operator.bitwise.shift.cs",
          "keyword.operator.assignment.compound.bitwise.cs",
          "keyword.operator.comparison.cs",
          "keyword.operator.logical.cs"
        ]
      },
      {
        "scopeName": "apim.expression.injection",
        "path": "./syntaxes/apim-expression.injection.json",
        "injectTo": [
          "text.xml.apim"
        ],
        "embeddedLanguages": {
          "meta.embedded.expression.cs": "csharp",
          "meta.embedded.block.cs": "csharp"
        },
        "tokenTypes": {
          "meta.embedded.expression.cs": "other",
          "meta.embedded.block.cs": "other",
          "meta.embedded.expression.cs string": "string",
          "meta.embedded.block.cs string": "string",
          "meta.embedded.expression.cs comment": "comment",
          "meta.embedded.block.cs comment": "comment"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational.cs",
          "keyword.operator.arrow.cs",
          "punctuation.accessor.pointer.cs",
          "keyword.operator.bitwise.shift.cs",
          "keyword.operator.assignment.compound.bitwise.cs",
          "keyword.operator.comparison.cs",
          "keyword.operator.logical.cs"
        ]
      }
    ],
    "configuration": {
      "title": "APIM Policy",
      "properties": {
        "apimPolicy.files.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra glob patterns for XML files that are APIM policies, for example `**/policies/**/*.xml`. `*.policy.xml` is always included."
        },
        "apimPolicy.files.detectByContent": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Treat an `.xml` file as an APIM policy when its root element is `<policies>` or `<fragment>`. Covers the APIOps `policy.xml` layout."
        },
        "apimPolicy.csharp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "C# IntelliSense and type checking inside policy expressions, from the C# extension (`ms-dotnettools.csharp`) or the built-in engine (see `apimPolicy.csharp.mode`)."
        },
        "apimPolicy.csharp.mode": {
          "type": "string",
          "enum": [
            "auto",
            "file",
            "virtual",
            "builtin"
          ],
          "enumDescriptions": [
            "The C# extension when it's installed (`file` with the .NET 10 SDK, otherwise `virtual`), the built-in engine when it isn't.",
            "The C# extension, with a hidden .NET 10 file-based app in extension storage: completion, hover and type errors.",
            "The C# extension, with an in-memory document: completion and hover. Type errors come from the built-in engine.",
            "The built-in engine only. Never starts the C# extension, works in Restricted Mode."
          ],
          "default": "auto",
          "markdownDescription": "Which C# implementation answers inside expressions. Takes effect after a reload."
        },
        "apimPolicy.allowedTypes.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "markdownDescription": "Severity for .NET types and members that APIM doesn't allow in policy expressions."
        }
      }
    },
    "snippets": [
      {
        "language": "apim-policy",
        "path": "./snippets/apim-policy.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --tests && node out/test/integration/runTest.js",
    "test:integration:builtin": "node esbuild.mjs && node esbuild.mjs --tests && APIM_IT_NO_CSHARP=1 node out/test/integration/runTest.js",
    "package": "node esbuild.mjs --production && vsce package --no-update-package-json --no-dependencies \"$(scripts/ci/version.sh)\"",
    "spike": "node esbuild.mjs --spike && node out/spike/run.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "diff": "^8.0.3"
  }
}
