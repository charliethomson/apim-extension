{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "apim.expression.injection",
  "injectionSelector": "L:text.xml.apim -comment -meta.embedded",
  "patterns": [{ "include": "#block" }, { "include": "#expression" }, { "include": "#named-value" }],
  "repository": {
    "expression": {
      "begin": "(@)(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.expression.apim" },
        "2": { "name": "punctuation.section.embedded.begin.apim" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.apim" } },
      "contentName": "meta.embedded.expression.cs",
      "patterns": [{ "include": "#named-value" }, { "include": "source.cs#expression" }]
    },
    "block": {
      "begin": "(@)(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.expression.apim" },
        "2": { "name": "punctuation.section.embedded.begin.apim" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.apim" } },
      "contentName": "meta.embedded.block.cs",
      "patterns": [{ "include": "#named-value" }, { "include": "source.cs#statement" }]
    },
    "named-value": {
      "match": "\\{\\{[A-Za-z0-9._-]+\\}\\}",
      "name": "variable.other.named-value.apim"
    }
  }
}
