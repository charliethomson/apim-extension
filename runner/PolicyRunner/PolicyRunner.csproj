<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs APIM policies for the policy tests: expressions compiled with Roslyn at C# 7.3, the
       context implemented for real, the outside world mocked. See docs/policy-testing-plan.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The stubs' interfaces, with the working helpers from Helpers.cs in place of their throw-null ones. -->
    <DefineConstants>$(DefineConstants);APIM_RUNNER</DefineConstants>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>apim-policy-runner</AssemblyName>
    <RootNamespace>PolicyRunner</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../packages/csharp-engine/assets/ApimContext.cs" Link="ApimContext.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PolicyRunner.Tests" />
  </ItemGroup>
</Project>
