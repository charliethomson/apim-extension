<?xml version="1.0" encoding="utf-8"?>
<!-- The runner restores from nuget.org only, so a machine's own feeds don't change what it builds with. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
