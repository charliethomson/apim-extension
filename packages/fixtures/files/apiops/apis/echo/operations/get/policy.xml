<policies>
    <inbound>
        <base />
        <set-header name="x-tenant" exists-action="override">
            <value>@((string)context.Variables["tenant-name"] + "/" + (string)context.Variables["product-tier"])</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
